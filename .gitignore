# --- secrets ---
.env
*.key

# --- raw data (large; exceeds GitHub's 100MB limit, provided separately by organisers) ---
data/*.csv

# --- DuckDB materialisation of the raw CSVs (regenerable cache, can be large) ---
*.duckdb
*.duckdb.wal

# --- LLM response cache (regenerable; prompts/ themselves ARE committed as evidence) ---
cache/

# small derived artefacts under data/processed/ (parquet tables, profiling
# reports) ARE committed on purpose -- they're deliverable evidence and cheap.

# --- python ---
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# --- os / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- outputs that are regenerated by run_all.py ---
reports/*.html
